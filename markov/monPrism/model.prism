dtmc

const double p = 0.4;

module M 
  x : [0..2];

  // x = 0 correspond à E_d
  [] x=0 -> 
     0.655 + (0.345 * 0.0525) * p : (x'=0) +
     0.345 - (0.345 * 0.0525) * p : (x'=1);

  // x = 1 correspond à I_d
  [] x=1 -> 
     (0.545 * 0.0525) * p : (x'=0) +
     0.545 - (0.545 * 0.0525) * p : (x'=1) +
     0.455 - (0.455 * 0.705) * p : (x'=2);

  // x = 2 correspond à P_d
  [] x=2 -> 
     0.705 * p : (x'=1) +
     1 - 0.705 * p : (x'=2);

endmodule
